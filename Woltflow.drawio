        <mxCell id="R9d-7NJiSH4ExI2Srzwc-109" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;woltflow-server-dev-il-central-1-lambdaRole&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;have the following permission&lt;/span&gt;&lt;font color=&quot;rgba(0, 0, 0, 0)&quot;&gt;&lt;span style=&quot;font-size: 12px; font-weight: normal;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;Lambda:&lt;/p&gt;&lt;p&gt;InvokeFunction (&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;refreshTokens,&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;woltBuyGift,&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;getDailyCode,&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;woltApplyGift)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;CloudWatch:&lt;br&gt;&lt;/p&gt;&lt;p&gt;CreateLogStream, CreateLogGroup, TagResource, PutLogEvents&lt;/p&gt;&lt;p&gt;ECR:&lt;/p&gt;&lt;p&gt;GetAuthorizationToken, BatchCheckLayerAvailability, GetDownloadUrlForLayer, BatchGetImage, InitiateLayerUpload, UploadLayerPart, CompleteLayerUpload, PutImage&lt;/p&gt;&lt;p&gt;S3:&lt;/p&gt;&lt;p&gt;PutObject, GetObject (woltflow.shalev396.com-assets)&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;spacingLeft=10;" parent="1" vertex="1">
