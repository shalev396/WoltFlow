        </mxCell>
        <mxCell id="9kkn8KtMeltp_yFVbk_v-331" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Create proper DEV / QA / PROD&amp;nbsp;&amp;nbsp;env&lt;/h1&gt;&lt;p&gt;deploy them on aws&lt;br&gt;run test daily on QA&amp;nbsp;&lt;br&gt;1. ui&lt;br&gt;2. api&lt;br&gt;3. automation (1 step away from buying adn applying codes)&amp;nbsp;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="1" vertex="1">
