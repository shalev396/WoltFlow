        <mxCell id="9kkn8KtMeltp_yFVbk_v-326" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Automation errors&lt;/h1&gt;&lt;p&gt;Fix automation when it has an active order&lt;br&gt;fix automation when it has an order from a different restaurant&lt;br&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="1" vertex="1">
