        <mxCell id="R9d-7NJiSH4ExI2Srzwc-97" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;startAllRuns&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal;&quot;&gt;Start automation runs for all users&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;Handler:./dist/handlers/automation/startAllRuns.handler&lt;/p&gt;&lt;p&gt;Triggers: EventBridge trigger&amp;nbsp;on weekdays at 10:00 UTC (12:00 Israel time)&amp;nbsp;&lt;br&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;GET&amp;nbsp;/api/automation/start-all-runs&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Runtime: Node 22.x&lt;br&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;spacingLeft=10;" vertex="1" parent="1">
