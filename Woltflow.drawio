        <mxCell id="R9d-7NJiSH4ExI2Srzwc-105" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;woltflow-server-dev-StartAllRunsEventsRuleSchedule1&lt;br&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;The rule that starts the&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal;&quot;&gt;startAllRuns lambda function&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;Trigger:&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;trigger&amp;nbsp;on weekdays at 10:00 UTC (12:00 Israel time)&amp;nbsp;&lt;br&gt;&lt;br&gt;Target:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;woltflow-server-dev-startAllRuns&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;spacingLeft=10;" parent="1" vertex="1">
