        </mxCell>
        <mxCell id="9kkn8KtMeltp_yFVbk_v-327" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Notification sms/email&lt;/h1&gt;&lt;p&gt;Add a notification for error on sms/email&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Add an option for notification on success&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="1" vertex="1">
