        <mxCell id="R9d-7NJiSH4ExI2Srzwc-98" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;refreshTokens&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal;&quot;&gt;Refresh users&#39; Wolt tokens&amp;nbsp;&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;Handler: ./dist/handlers/automation/refreshTokens.handler&lt;/p&gt;&lt;p&gt;Trigger: &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;GET&amp;nbsp;/api/wolt/refreshTokens&lt;/font&gt;&lt;br&gt;&lt;br&gt;Runtime: Node 22.x&lt;br&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;spacingLeft=10;" vertex="1" parent="1">
