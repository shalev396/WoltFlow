        <mxCell id="R9d-7NJiSH4ExI2Srzwc-101" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;woltBuyGift&lt;/h1&gt;&lt;p&gt;Run Selenium to buy the user a Wolt gift card&amp;nbsp;&lt;br&gt;&lt;br&gt;Handler: dist/handlers/automation/woltBuyGift.handler&lt;/p&gt;&lt;p&gt;Trigger:&lt;/p&gt;&lt;p&gt;Timeout:200 seconds&lt;br&gt;&lt;br&gt;Runtime: Docker image: &quot;woltflow-selenium-image&quot;&lt;br&gt;&lt;br&gt;MemorySize:&amp;nbsp;1536 MB&lt;br&gt;&lt;br&gt;EphemeralStorageSize:&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1536 MB&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="2880" width="360" height="240" as="geometry" />
