        <mxCell id="R9d-7NJiSH4ExI2Srzwc-99" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;getDailyCode&lt;/h1&gt;&lt;p&gt;Uses Gmail API to get wolt codes form user inbox&lt;br&gt;&lt;br&gt;Handler: ./dist/handlers/gmail/getDailyCode.handler&lt;/p&gt;&lt;p&gt;Trigger: &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;GET /api/gmail/daily-code&lt;/font&gt;&lt;br&gt;&lt;br&gt;Runtime: Node 22.x&lt;br&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;spacingLeft=10;" parent="1" vertex="1">
