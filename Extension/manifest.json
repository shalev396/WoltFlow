{
  "manifest_version": 3,
  "name": "WoltFlow Token Reviewer",
  "version": "1.0.0",
  "description": "Review access and refresh tokens from Wolt.com",
  "permissions": ["cookies"],
  "host_permissions": ["*://*.wolt.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WoltFlow Token Reviewer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
