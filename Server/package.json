{
  "name": "woltflow-server",
  "version": "1.0.0",
  "description": "WoltFlow Serverless Backend",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc && webpack",
    "build:tsc": "tsc",
    "build:webpack": "webpack",
    "lint": "eslint .",
    "dev": "npm run build && concurrently \"npm run watch\" \"npm run serve:dev\"",
    "qa": "npm run build && concurrently \"npm run watch\" \"npm run serve:qa\"",
    "prod": "npm run build && concurrently \"npm run watch\" \"npm run serve:prod\"",
    "watch": "nodemon",
    "serve:dev": "cross-env IS_LOCAL=true serverless offline --stage dev",
    "serve:qa": "cross-env IS_LOCAL=true serverless offline --stage qa",
    "serve:prod": "cross-env IS_LOCAL=true serverless offline --stage prod",
    "deploy:dev": "npm run build && cross-env DOCKER_BUILDKIT=0 IS_LOCAL=false serverless deploy --stage dev",
    "deploy:qa": "npm run build && cross-env DOCKER_BUILDKIT=0 IS_LOCAL=false serverless deploy --stage qa",
    "deploy:prod": "npm run build && cross-env DOCKER_BUILDKIT=0 IS_LOCAL=false serverless deploy --stage prod"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1056.0",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.1056.0",
    "@aws-sdk/client-s3": "^3.1056.0",
    "@aws-sdk/client-ses": "^3.1056.0",
    "@aws-sdk/client-sfn": "^3.1056.0",
    "@aws-sdk/s3-request-presigner": "^3.1056.0",
    "@googleapis/oauth2": "^2.0.1",
    "@types/express": "^5.0.6",
    "archiver": "^7.0.1",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "selenium-webdriver": "^4.44.0",
    "sequelize": "^6.37.8",
    "serverless-http": "^4.0.0",
    "uuid": "^14.0.0"
  },
  "overrides": {
    "sequelize": {
      "uuid": ">=11.1.1"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@smithy/types": "^4.14.2",
    "@types/archiver": "^5.3.4",
    "@types/aws-lambda": "^8.10.161",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "@types/selenium-webdriver": "^4.35.6",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14",
    "serverless-ecr-image-cleaner": "1.0.1",
    "serverless-offline": "^14.7.1",
    "serverless-prune-plugin": "^2.1.0",
    "serverless-step-functions": "^3.30.0",
    "ts-loader": "^9.5.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^5.1.4"
  }
}
