{
  "name": "woltflow-server",
  "version": "1.0.0",
  "description": "WoltFlow Serverless Backend",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "build": "tsc && webpack",
    "build:tsc": "tsc",
    "build:webpack": "webpack",
    "dev": "npm run build:webpack && serverless offline --stage local",
    "deploy:dev": "npm run build:webpack && cross-env DOCKER_BUILDKIT=0  serverless deploy --stage dev",
    "deploy:prod": "npm run build:webpack && cross-env DOCKER_BUILDKIT=0  serverless deploy --stage prod",
    "test:woltBuyGift": "serverless invoke -f woltBuyGift --path woltBuyGift.json"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.840.0",
    "@aws-sdk/client-s3": "^3.848.0",
    "@aws-sdk/client-ses": "^3.848.0",
    "@aws-sdk/client-sfn": "^3.856.0",
    "@aws-sdk/client-sns": "^3.840.0",
    "@googleapis/gmail": "^13.0.1",
    "@googleapis/oauth2": "^2.0.1",
    "aws-lambda": "^1.0.7",
    "dotenv": "^16.5.0",
    "google-auth-library": "^10.1.0",
    "jsonwebtoken": "^9.0.2",
    "patch-package": "^8.0.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.2",
    "pg-hstore": "^2.3.4",
    "selenium-webdriver": "^4.33.0",
    "sequelize": "^6.37.7",
    "serverless-offline": "^14.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.150",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.4",
    "@types/selenium-webdriver": "^4.1.28",
    "@types/uuid": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "cross-env": "^7.0.3",
    "glob": "^11.0.3",
    "serverless-prune-plugin": "^2.1.0",
    "serverless-step-functions": "^3.23.3",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  }
}
