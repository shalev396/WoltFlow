{
  "name": "woltflow-server",
  "version": "1.0.0",
  "description": "WoltFlow Serverless Backend",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "build": "tsc && webpack",
    "build:tsc": "tsc",
    "build:webpack": "webpack",
    "lint": "eslint .",
    "dev": "npm run build && concurrently \"npm run watch\" \"npm run serve:dev\"",
    "qa": "npm run build && concurrently \"npm run watch\" \"npm run serve:qa\"",
    "prod": "npm run build && concurrently \"npm run watch\" \"npm run serve:prod\"",
    "watch": "nodemon",
    "serve:dev": "cross-env IS_LOCAL=true serverless offline --stage dev",
    "serve:qa": "cross-env IS_LOCAL=true serverless offline --stage qa",
    "serve:prod": "cross-env IS_LOCAL=true serverless offline --stage prod",
    "deploy:dev": "npm run build && cross-env DOCKER_BUILDKIT=0 IS_LOCAL=false serverless deploy --stage dev",
    "deploy:qa": "npm run build && cross-env DOCKER_BUILDKIT=0 IS_LOCAL=false serverless deploy --stage qa",
    "deploy:prod": "npm run build && cross-env DOCKER_BUILDKIT=0 IS_LOCAL=false serverless deploy --stage prod"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.848.0",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.901.0",
    "@aws-sdk/client-s3": "^3.848.0",
    "@aws-sdk/client-ses": "^3.848.0",
    "@aws-sdk/client-sfn": "^3.856.0",
    "@aws-sdk/s3-request-presigner": "^3.848.0",
    "@googleapis/oauth2": "^2.0.1",
    "@types/express": "^5.0.6",
    "archiver": "^7.0.1",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "google-auth-library": "^10.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "patch-package": "^8.0.0",
    "pg": "^8.16.2",
    "pg-hstore": "^2.3.4",
    "selenium-webdriver": "^4.33.0",
    "sequelize": "^6.37.7",
    "serverless-http": "^4.0.0",
    "uuid": "^10.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@smithy/types": "^4.5.0",
    "@types/archiver": "^5.3.4",
    "@types/aws-lambda": "^8.10.158",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.3",
    "@types/pg": "^8.15.4",
    "@types/selenium-webdriver": "^4.1.28",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "nodemon": "^3.1.10",
    "serverless-ecr-image-cleaner": "^1.0.7",
    "serverless-offline": "^14.4.0",
    "serverless-prune-plugin": "^2.1.0",
    "serverless-step-functions": "^3.23.3",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.1",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  }
}
